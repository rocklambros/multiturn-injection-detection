FROM runpod/pytorch:2.4.0-py3.11-cuda12.4.1-devel-ubuntu22.04

RUN apt-get update -qq && apt-get install -y -qq git && rm -rf /var/lib/apt/lists/*

COPY scripts/bootstrap_runpod.sh /opt/bootstrap_runpod.sh
COPY scripts/run_training.py /opt/run_training.py
COPY requirements.txt /opt/requirements.txt

COPY docker_entrypoint.sh /opt/docker_entrypoint.sh
RUN chmod +x /opt/docker_entrypoint.sh /opt/bootstrap_runpod.sh

CMD ["/opt/docker_entrypoint.sh"]
